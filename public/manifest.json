{
  "manifest_version": 3,
  "name": "Workpad",
  "version": "0.1.0",
  "description": "A contextual notebook beside every browser tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": { "default_title": "Open Workpad" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "contextMenus"],
  "commands": {
    "open-workpad": {
      "suggested_key": { "default": "Alt+Shift+W", "mac": "Alt+Shift+W" },
      "description": "Open Workpad"
    },
    "new-note": { "description": "Create a standalone note" },
    "focus-search": { "description": "Focus Workpad search" },
    "open-scratchpad": { "description": "Open Workpad scratchpad" }
  }
}
