{
  "manifest_version": 3,
  "name": "Workpad",
  "version": "0.1.1",
  "key": "",
  "description": "AI research assistant beside every tab: ask about any page, collect sources and decide with cited evidence.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": { "default_title": "Open Workpad" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://*.supabase.co; object-src 'none'; base-uri 'none'"
  },
  "oauth2": {
    "client_id": "108759011164-r43rdi0tdfpokaagg18fmogics6e449n.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "contextMenus", "scripting", "identity", "alarms", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "open-workpad": {
      "suggested_key": { "default": "Alt+Shift+W", "mac": "Alt+Shift+W" },
      "description": "Open Workpad"
    },
    "new-note": { "description": "Create a standalone note" },
    "focus-search": { "description": "Focus Workpad search" }
  }
}
